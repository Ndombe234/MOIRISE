  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.6",
    "typescript": "7.0.2",
